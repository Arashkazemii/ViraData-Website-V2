# Set to the verified public origin before production publication, e.g. https://example.com
NEXT_PUBLIC_SITE_ORIGIN=
# Contact form SMTP settings. Set on the server only; never use NEXT_PUBLIC_ for secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender address authorized by the SMTP provider.
SMTP_FROM=
# Set only after the approved final logo is confirmed. Defaults to supplied logo-1.png mark.
NEXT_PUBLIC_LOGO_PATH=
